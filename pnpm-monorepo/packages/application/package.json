{
  "name": "@sam-monorepo/application",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist/*"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./test/*": "./test/*.ts"
  },
  "scripts": {
    "postinstall": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@sam-monorepo/database": "workspace:*",
    "@sam-monorepo/domain": "workspace:*",
    "@sam-monorepo/wiki-editor": "workspace:*",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "testcontainers": "12.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
