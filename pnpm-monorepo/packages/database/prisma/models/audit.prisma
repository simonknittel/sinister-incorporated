model AuditEvent {
  id              String   @id @default(cuid(2))
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  createdBy       User?    @relation("createdBy", fields: [createdById], references: [id])
  createdById     String?
  type            String
  data            Json
  triggeredViaMcp Boolean  @default(false)

  // The system log always sorts by (createdAt, id) and optionally narrows by
  // type and/or creator, so both filters are indexed together with the full
  // sort key instead of on their own. Carrying id keeps the tie-breaking sort
  // that makes its cursor pagination well-defined inside the index scan.
  @@index([createdAt, id])
  @@index([type, createdAt, id])
  @@index([createdById, createdAt, id])
  // Almost all events are not through the MCP server, thus only the filter for
  // the MCP events needs an index. The other filter uses the (createdAt, id) index.
  @@index([createdAt, id], map: "AuditEvent_triggeredViaMcp_createdAt_id_idx", where: { triggeredViaMcp: true })
}
